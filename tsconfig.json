{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "outDir": "dist"
  },
  "include": ["./hardhat.config.ts", "./scripts", "./test", "./ignition", "./types"],
  "exclude": ["node_modules", "dist", "artifacts", "cache"]
}
